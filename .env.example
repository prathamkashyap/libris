# Libris — deployment environment template.
#
#   cp .env.example .env
#   chmod 600 .env
#   docker compose up -d
#
# .env is git-ignored. Never commit real values. On OCI, prefer injecting these
# from OCI Vault / OCI Secrets into the instance's systemd unit instead of
# writing them to disk at all — see docs/DEPLOYMENT.md.
#
# Every value below is read with compose's ${VAR:?} form for the required ones,
# so the stack refuses to start while any of them is empty.

# ---------------------------------------------------------------------------
# Required — MySQL root password
# Used only for container bootstrap and healthcheck. The application never
# connects as root.
# Generate: openssl rand -base64 32
# ---------------------------------------------------------------------------
LMS_DB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Required — MySQL password for the application account
# The mysql image creates this user with privileges on LMS_DB_NAME only.
# Generate: openssl rand -base64 32
# ---------------------------------------------------------------------------
LMS_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Required — initial ADMIN password
# AdminSeeder applies this on every start and refuses blank values and the
# legacy default. Rotate it after first login.
# There is deliberately no default value here.
# Generate: openssl rand -base64 24
# ---------------------------------------------------------------------------
LMS_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional — overrides
# ---------------------------------------------------------------------------

# Admin username. Keep the default unless you have a reason not to.
LMS_ADMIN_USERNAME=admin

# Dedicated application database account created by the mysql image.
LMS_DB_USERNAME=libris

# Schema name. Must match LMS_DB_URL if you override that.
LMS_DB_NAME=librarydb

# JDBC URL. Only override to point at an external MySQL (for example a managed
# service or a database on a different subnet — enable useSSL in that case).
# The default omits createDatabaseIfNotExist: the application account has no
# CREATE DATABASE privilege.
LMS_DB_URL=jdbc:mysql://mysql:3306/librarydb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&connectionTimeZone=UTC

# Address the application port is published on. Leave as 127.0.0.1 so the app
# is only reachable through the host reverse proxy.
LMS_BIND_ADDRESS=127.0.0.1

# JVM options. MaxRAMPercentage sizes the heap from the instance's memory.
# For a 1 GB shape, 70.0 yields a ~700 MB heap; lower it to ~60 for 1 GB
# shapes that also run MySQL on the same instance.
JAVA_OPTS=-XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom

# Optional — Google OAuth2 student login. Leave blank to keep OAuth disabled;
# the application does not create an OAuth client without the oauth profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
