[Unit]
Description=Libris MySQL backup (local dump, manifest and status)
Documentation=file:///home/opc/libris/docs/DEPLOYMENT.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/home/opc/libris
Environment=LIBRIS_BACKUP_KEEP=112
TimeoutStartSec=900

# Runs as root only because the Docker socket is required for
# `docker compose exec`. The container account used for the dump is the
# read-only libris_backup account, not MySQL root. opc is deliberately not a
# member of the docker group.
ExecStart=/usr/local/sbin/libris-backup-run

# Hardening. ProtectHome must stay read-only: the deployment .env and the
# scripts live under /home/opc, which this makes readable but not writable.
# Output is confined to the backup directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/libris-backups
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
